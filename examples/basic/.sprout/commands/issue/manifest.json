{
  "name": "issue",
  "description": "Create issue markdown",
  "inputs": [
    { "name": "name", "type": "string" },
    { "name": "type", "type": "enum", "enum": ["bug", "feat", "refactor"], "default": "bug" }
  ],
  "assets": [
    { "type": "dir", "path": "issues" },
    { "type": "file", "path": "issues/{{YY}}-{{MM}}-{{DD}}_{{name}}.md", "template": "issue.md" }
  ]
}
