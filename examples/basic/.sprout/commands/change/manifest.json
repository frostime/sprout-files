{
  "name": "change",
  "description": "Create change directory with proposal",
  "inputs": [
    { "name": "name", "type": "string" },
    { "name": "type", "type": "enum", "enum": ["bug", "feat", "refactor"], "default": "feat" }
  ],
  "assets": [
    { "type": "dir", "path": "changes/{{YY}}-{{MM}}-{{DD}}_{{name}}" },
    {
      "type": "file",
      "path": "changes/{{YY}}-{{MM}}-{{DD}}_{{name}}/proposal.md",
      "template": "proposal.md"
    }
  ]
}
